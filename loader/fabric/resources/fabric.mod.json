{
  "schemaVersion": 1,
  "id": "lightstones",
  "version": "${version}",
  "name": "Lightstones",
  "description": "Authentic lightstones straight from Onu-Koro!",
  "authors": [
    "Paperdomo101",
    "Sunconure11"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/lightstones",
    "issues": "https://github.com/Paperdomo101/lightstones/issues",
    "sources": "https://github.com/Paperdomo101/lightstones"
  },
  "license": "MIT",
  "icon": "assets/lightstones/icon.png",
  "accessWidener": "lightstones.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": [
      "paperdomo101.lightstones.fabric.LightstonesFabric"
    ],
    "client": [
      "paperdomo101.lightstones.fabric.client.LightstonesFabricClient"
    ],
    "modmenu": [
      "paperdomo101.lightstones.fabric.config.LightstonesModMenu"
    ]
  },
  "mixins": [
    "lightstones-common.mixins.json",
    "lightstones-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_dep}",
    "${fabric_api_id}": "*",
    "minecraft": "${mc_dep}",
    "java": ">=${java_major}"
  },
  "suggests": {
    "cloth-config": "*"
  }
}
